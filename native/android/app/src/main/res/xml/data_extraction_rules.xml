<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: nothing the app holds (settings, tokens, the WebView's storage) is copied to the cloud or to another
     device. allowBackup is false as well; these rules say the same thing for the transfer paths that read them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
