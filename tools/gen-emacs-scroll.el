(setq make-backup-files nil auto-save-default nil inhibit-startup-screen t)
(defvar out "/tmp/scr/out.txt")
(defun lines-text (n) ;; varied line lengths, none longer than 60
  (mapconcat (lambda (i) (make-string (% (* i 7) 23) (+ ?a (% i 26)))) (number-sequence 1 n) "\n"))
(defun run-case (nlines sline pline col keys)
  (erase-buffer) (insert (lines-text nlines)) (goto-char (point-min))
  (forward-line (1- sline)) (let ((s (point))) (set-window-start nil s)
  (goto-char s) (forward-line (1- pline)) (move-to-column col)
  (redisplay t)
  (let ((p0 (point)) (res nil))
    (dolist (k keys)
      (condition-case err (execute-kbd-macro (kbd k)) (error (push (format "E:%s" (cadr err)) res)))
      (redisplay t)
      (push (format "%d,%d" (point) (window-start)) res))
    (append-to-file (format "%d %d %d %d %S %d %s\n" nlines sline pline col keys p0 (mapconcat #'identity (reverse res) " ")) nil out))))
(defun run-all ()
  (switch-to-buffer "t") (setq truncate-lines t)
  (dolist (nl '(15 30 100))
    (dolist (sl '(1 2 10))
      (dolist (pl '(1 2 11 22))
        (dolist (col '(0 3 15))
          (dolist (keys '(("C-v") ("M-v") ("C-v" "C-v") ("C-v" "M-v") ("C-u 3 C-v") ("C-u -3 C-v") ("C-u 3 M-v") ("C-v" "C-v" "C-v" "C-v" "C-v") ("M-v" "M-v")))
            (when (<= sl nl) (run-case nl sl pl col keys)))))))
  (append-to-file "done\n" nil out) (kill-emacs))
(run-with-timer 1 nil #'run-all)
