(require 'org) (require 'ob-js) (require 'json)
(defun dump-blocks (file)
  (find-file file)
  (let (out)
    (org-babel-map-src-blocks nil
      (let* ((info (org-babel-get-src-block-info 'no-eval))
             (params (nth 2 info))
             (keys '(:results :exports :noweb :tangle :cache :hlines :eval :session :mkdirp :shebang :comments :padline :noweb-ref :noweb-sep :tangle-mode :net :timeout :wrap :noweb-prefix :var :dir))
             (alist nil))
        (dolist (k keys)
          (if (eq k :var)
              (let ((vs (delq nil (mapcar (lambda (p) (when (eq (car p) :var) (format "%s" (cdr p)))) params))))
                (when vs (push (cons "var" (vconcat vs)) alist)))
            (let ((p (assq k params)))
              (when p (push (cons (substring (symbol-name k) 1) (format "%s" (cdr p))) alist)))))
        (push (list (cons "lang" (nth 0 info)) (cons "name" (nth 4 info)) (cons "params" (nreverse alist))) out)))
    (princ (json-encode (vconcat (nreverse out))))))
(dump-blocks (car command-line-args-left))
