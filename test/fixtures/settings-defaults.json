{
 "calendar-date-style": "american",
 "calendar-latitude": "nil",
 "calendar-longitude": "nil",
 "calendar-time-display-form": "(12-hours \":\" minutes am-pm (if time-zone \" (\") time-zone (if time-zone \")\"))",
 "diary-abbreviated-year-flag": "t",
 "diary-file": "\"~/.emacs.d/diary\"",
 "diary-show-holidays-flag": "t",
 "display-time-mode": "nil",
 "display-line-numbers-mode": "nil",
 "display-line-numbers-type": "t",
 "display-line-numbers-widen": "nil",
 "org-agenda-files": "nil",
 "org-agenda-include-diary": "nil",
 "org-agenda-show-all-dates": "t",
 "org-agenda-show-future-repeats": "t",
 "org-agenda-start-on-weekday": "1",
 "org-agenda-text-search-extra-files": "nil",
 "org-ascii-charset": "ascii",
 "org-ascii-text-width": "72",
 "org-attach-method": "cp",
 "org-babel-load-languages": "((emacs-lisp . t))",
 "org-cycle-open-archived-trees": "nil",
 "org-deadline-warning-days": "14",
 "org-habit-following-days": "7",
 "org-habit-preceding-days": "21",
 "org-habit-show-all-today": "nil",
 "org-habit-show-habits-only-for-today": "t",
 "org-html-head": "\"\"",
 "org-html-postamble": "auto",
 "org-html-preamble": "t",
 "org-latex-compiler": "\"pdflatex\"",
 "org-latex-default-class": "\"article\"",
 "org-log-done": "nil",
 "org-priority-highest": "65",
 "org-priority-lowest": "67",
 "org-refile-targets": "nil",
 "org-scheduled-delay-days": "0",
 "org-startup-folded": "showeverything",
 "org-startup-indented": "nil",
 "org-startup-truncated": "t",
 "org-startup-with-inline-images": "nil",
 "org-tags-column": "-77",
 "org-use-sub-superscripts": "t",
 "org-use-tag-inheritance": "t",
 "diary-date-forms": "((month \"/\" day \"[^/0-9]\") (month \"/\" day \"/\" year \"[^0-9]\") (monthname \" *\" day \"[^,0-9]\") (monthname \" *\" day \", *\" year \"[^0-9]\") (dayname \"\\\\W\"))",
 "org-agenda-clock-consistency-checks": "(:max-duration \"10:00\" :min-duration 0 :max-gap \"0:05\" :gap-ok-around (\"4:00\") :default-face ((:background \"DarkRed\") (:foreground \"white\")) :overlap-face nil :gap-face nil :no-end-time-face nil :long-face nil :short-face nil)",
 "org-agenda-prefix-format": "((agenda . \" %i %-12:c%?-12t% s\") (todo . \" %i %-12:c\") (tags . \" %i %-12:c\") (search . \" %i %-12:c\"))",
 "org-agenda-sorting-strategy": "((agenda habit-down time-up priority-down category-keep) (todo priority-down category-keep) (tags priority-down category-keep) (search category-keep))"
}
