{
 "emacs": "29.3",
 "defs": "#+LINK: gh https://github.com/%s\n#+LINK: two https://x.org/%s/and/%s\n#+LINK: enc https://x.org/q?=%h\n#+LINK: both https://x.org/%s?q=%h\n#+LINK: plain https://x.org/base/\n#+LINK: dup https://first/%s\n#+LINK: dup https://second/%s\n#+LINK: Case https://case/%s\n#+LINK: empty-tag https://t/%s/end\n#+LINK: pct https://x.org/100%25/%s\n#+LINK: fn https://x.org/%(someFunction)",
 "cases": [
  {
   "target": "gh:org/repo",
   "emacs": "https://github.com/org/repo"
  },
  {
   "target": "gh:",
   "emacs": "https://github.com/"
  },
  {
   "target": "gh",
   "emacs": "https://github.com/"
  },
  {
