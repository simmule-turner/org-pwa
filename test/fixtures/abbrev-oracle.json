  },
  {
   "target": "gh:a:b",
   "emacs": "https://github.com/a:b"
  },
  {
   "target": "gh:with space",
   "emacs": "https://github.com/with space"
  },
  {
   "target": "two:one",
   "emacs": "https://x.org/one/and/%s"
  },
  {
   "target": "enc:a b&c/d?e",
   "emacs": "https://x.org/q?=a%20b%26c%2Fd%3Fe"
  },
  {
   "target": "enc:café ☕",
   "emacs": "https://x.org/q?=caf%C3%A9%20%E2%98%95"
  },
  {
   "target": "both:x y",
   "emacs": "https://x.org/x y?q=%h"
  },
  {
   "target": "plain:index.html",
   "emacs": "https://x.org/base/index.html"
  },
  {
   "target": "plain:",
   "emacs": "https://x.org/base/"
  },
  {
   "target": "dup:z",
