  },
  {
   "name": "i4c",
   "files": {
    "sub/c.org": "* A\n"
   },
   "main": "#+INCLUDE: \"sub/c.org::nope\"\n",
   "want": "ERROR No match for fuzzy expression: nope for sub/c.org::nope"
  },
  {
